# Use Neon / Postgres URL, or leave empty to use embedded PGlite (.data/pglite)
DATABASE_URL=postgresql://logbitts:logbitts@localhost:5432/logbitts

# Better Auth — em produção (Railway) use a URL pública HTTPS do app
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Railway example:
# BETTER_AUTH_URL=https://logbitts-production.up.railway.app
# NEXT_PUBLIC_APP_URL=https://logbitts-production.up.railway.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Map style (MapLibre). Default = free OpenFreeMap
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# POD storage: local (default) writes to ./uploads
STORAGE_DRIVER=local

# Fiscal partner (Phase 4). mock = local homologação; http_stub = POST /emit|/cancel
FISCAL_PROVIDER=mock
FISCAL_ENVIRONMENT=homologacao
# FISCAL_PARTNER_URL=https://parceiro.exemplo/api/fiscal
# FISCAL_API_KEY=
# FISCAL_COMPANY_CNPJ=00.000.000/0001-91
# FISCAL_COMPANY_NAME=Distribuidora Demo Logbitts

# ERP / Winthor (Phase 6) — mock by default; set HTTP via UI /integracoes/winthor
# WEBHOOK demo secret is stored on the connector config (default: logbitts-demo-webhook)
